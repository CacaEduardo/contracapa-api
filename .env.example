NODE_ENV=development
# Local: 3001. Cloud Run injeta PORT=8080.
PORT=3001
MONGO_URL=
JWT_SECRET=
INTERNAL_TOKEN=
ALLOWED_ORIGINS=

# Conta de admin (seed local; nunca commitar valores preenchidos)
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# URL pública do frontend (usada para montar links em e-mails)
FRONTEND_URL=

# Upload de imagens (S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
BUCKET_NAME=

# Envio de e-mail (Resend) — opcional: sem a key, o app loga aviso e segue sem enviar
RESEND_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=
